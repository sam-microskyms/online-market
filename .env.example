# Copy to .env.local for a configured shop. Leave blank to run the storefront
# in preview mode: illustrations stay visible and orders, accounts, and seller
# tools stay closed. Do not commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# All default off. Turning these on is an explicit launch decision.
# COD_ENABLED also means you have a real delivery workflow outside this app.
# PREPAID_ENABLED requires PAYMENT_WEBHOOK_SECRET and a gateway you have approved.
CHECKOUT_ENABLED=false
COD_ENABLED=false
PREPAID_ENABLED=false
PAYMENT_WEBHOOK_SECRET=
